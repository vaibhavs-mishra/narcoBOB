# Copy this file to .env and adjust. NEVER commit .env (it is gitignored).
# Every value below is the default; the system runs with no .env at all.

# ── IBM Bob Shell (agents) ────────────────────────────────────────────────────
# "bob" runs the four agents as headless Bob Shell custom modes.
# "fallback" uses the deterministic rule-based agents (no Bob needed).
NARCOBOB_AGENTS_MODE=bob
# Path to the Bob Shell binary (or a wrapper script).
BOB_BIN=bob
# Inference-scoped API key from the Bob portal; used for headless runs.
BOB_API_KEY=your_bob_api_key_here
# Timeout per agent step attempt, in seconds.
BOB_AGENT_TIMEOUT_S=180

# ── Area and grid ────────────────────────────────────────────────────────────
NARCOBOB_AREA_NAME=Amritsar–Tarn Taran border belt
# lat_min,lon_min,lat_max,lon_max — change this to run anywhere
NARCOBOB_AREA_BBOX=31.20,74.50,31.90,75.20
# H3 resolution (6–8 sensible; 7 ≈ 5 km² hexagons)
NARCOBOB_H3_RES=7

# ── Time and simulation (the event feed is SIMULATED) ─────────────────────────
# One time bucket = one simulated day
NARCOBOB_BUCKET_SIM_SECONDS=86400
# 28800 = one simulated day every 3 wall-clock seconds
NARCOBOB_SIM_SECONDS_PER_WALL_SECOND=28800
# Simulated days of history generated on start
NARCOBOB_BACKFILL_BUCKETS=60
# Scenario file name in src/scenarios/ (without .yaml)
NARCOBOB_SCENARIO=demo_border_surge
NARCOBOB_SEED=42

# ── Scoring engine ───────────────────────────────────────────────────────────
# Seconds between scoring passes
NARCOBOB_SCORE_INTERVAL_S=2
# Component weights: accel,div,spill,gi
NARCOBOB_WEIGHTS=0.35,0.25,0.20,0.20
# Score thresholds: watch,high,critical
NARCOBOB_THRESHOLDS=60,75,88
# Wall-clock seconds before the same cell can alert again
NARCOBOB_ALERT_COOLDOWN_S=120
# Wall-clock seconds to gather alerts into one agent run
NARCOBOB_ALERT_COALESCE_S=15

# ── Processes and storage ────────────────────────────────────────────────────
NARCOBOB_API_PORT=8000
NARCOBOB_MCP_PORT=8765
NARCOBOB_SIM_PORT=8001
# SQLite file, relative to src/
NARCOBOB_DB_PATH=var/narcobob.db
# Record every WebSocket message to recordings/ for replay
NARCOBOB_RECORD=true
# Recording served by `make replay`
NARCOBOB_REPLAY_FILE=recordings/demo_golden.jsonl

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
